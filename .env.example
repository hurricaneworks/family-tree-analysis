# Copy to .env.local and fill in what you need.
# The app runs with NONE of this set: it falls back to the first person in your
# file and to neutral wording. Every section below is optional.

# ---------------------------------------------------------------------------
# Your tree
# ---------------------------------------------------------------------------
# The person generations are counted from. Find the id in a person page URL.
# Leave blank to use the first individual in the file, which is usually right.
NEXT_PUBLIC_ROOT_ID=
# What to call them in copy: a first name, or "Gran".
NEXT_PUBLIC_ROOT_SHORT_NAME=
# The tree's name, shown on printed pages and shared links.
NEXT_PUBLIC_TREE_NAME=
# What to call whoever runs the site, in copy: a first name, or "the keeper".
NEXT_PUBLIC_OWNER_NAME=
# Anyone with no death recorded and a first known year within the last hundred
# years has their dates, places, events, notes and pictures withheld. Only their
# name and place in the tree show. Set to true to show everything, for a site
# that only the family can reach.
SHOW_LIVING_PEOPLE=

# Where the site is served from. Emails need absolute links, so set this
# before sending any.
SITE_URL=http://localhost:4130

# ---------------------------------------------------------------------------
# Sign-in (optional: needed only if you want the site private)
# ---------------------------------------------------------------------------
# Without these three the site has no sign-in at all and keeps nothing that is
# written on it (comments, lists, merge decisions). Fine on your own computer;
# never deploy it to the open internet like that.
# A Supabase project provides email-and-password sign-in. Public signups should
# be disabled in the Supabase dashboard; list the addresses allowed in below.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=
ALLOWED_EMAILS=you@example.com,someone@example.com

# Skips sign-in under `npm run dev` only. Has no effect on a production build.
DEV_AUTH_BYPASS=

# ---------------------------------------------------------------------------
# Email (optional: comments and the weekly digest)
# ---------------------------------------------------------------------------
RESEND_API_KEY=
# The From line. Must be a sender your mail provider has verified.
MAIL_FROM=The family tree <no-reply@example.com>
# Who is told about new comments, and who replies go to.
OWNER_EMAIL=
# Who receives the weekly digest, and the shared secret its cron call must send.
DIGEST_TO=
DIGEST_SECRET=

# ---------------------------------------------------------------------------
# Third-party lookups
# ---------------------------------------------------------------------------
# Nominatim and Wikipedia ask automated callers to identify themselves.
# Set an email address or a URL before any bulk geocoding run.
CONTACT_EMAIL=
USER_AGENT_CONTACT=

# ---------------------------------------------------------------------------
# AI features (all optional, all cost money per use)
# ---------------------------------------------------------------------------
# Without a key the tree chat and the document readings are
# unavailable and the rest of the app works normally.
ANTHROPIC_API_KEY=
